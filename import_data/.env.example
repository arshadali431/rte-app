# Import tool environment template — copy to `.env` (git-ignored) and fill locally.
# Empty placeholders only — never commit real values.
#
# Credentials: prefer Application Default Credentials instead of a key file:
#   gcloud auth application-default login
# or point GOOGLE_APPLICATION_CREDENTIALS at a key stored OUTSIDE this repository.
#
# The sheet should be private or shared with a dedicated service account;
# avoid link-shared public CSV exports (see ../CREDENTIALS.md).

GOOGLE_APPLICATION_CREDENTIALS=
IMPORT_SHEET_CSV_URL=
