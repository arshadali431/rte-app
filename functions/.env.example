# Functions environment template — documents the Secret Manager names used by
# index.js. These are NOT loaded from this file at runtime; they must be created
# with `firebase functions:secrets:set <NAME>` and are injected via
# firebase-functions/params (defineSecret + runWith({ secrets })).
#
# NEVER put real values in a committed file.
# See ../CREDENTIALS.md for ownership, rotation and handover steps.
#
# Create/update each secret (the CLI prompts for the value, never echoes it):
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_ID
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set GOOGLE_DRIVE_REFRESH_TOKEN
#   firebase functions:secrets:set DRIVE_ROOT_FOLDER_ID

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
