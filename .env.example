# Root environment template — copy to `.env` for local tooling if needed.
# NEVER put real values in a committed file. `.env` is git-ignored.
#
# Most credentials do not belong here:
#   - Cloud Function OAuth values -> Google Cloud Secret Manager
#     (see functions/.env.example and CREDENTIALS.md)
#   - Firebase client keys       -> public identifiers in firebase_options.dart
#   - Android signing            -> android/key.properties (git-ignored)
#
# Empty placeholders only — no values.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
IMPORT_SHEET_CSV_URL=
